# Nicht geheim. Lokale Tokens gehoeren nach data.local.env (git-ignoriert).
DEVICE=cpu
LOAD_REFRESH_MINUTE=45
# Zweimal rund um den Gate-Cutoff, damit Sommer- und Winterzeit abgedeckt sind.
MARKET_HOURS_UTC=8,9
MARKET_MINUTE_UTC=20
WEATHER_HOURS_UTC=6,8,9
WEATHER_MINUTE_UTC=0
# Immer 11:55 Uhr deutscher Ortszeit, also nach den regulaeren Modelllaeufen.
SUMMARY_TIMEZONE=Europe/Berlin
SUMMARY_HOUR_LOCAL=11
SUMMARY_MINUTE_LOCAL=55
# Mail-/Summary-Job; die Worker-States sind unter /state/g1 und /state/g3 lesbar.
SUMMARY_MODULE=pipeline.status
SUMMARY_ARGS=--send
# Wird vom Summary-Modul fuer eine eindeutige Modellbezeichnung bereitgestellt.
SUMMARY_MODEL_LABELS=ea-g1-c1: amazon/chronos-2 (120M), G1_C1 univariat; ea-g3-c5: amazon/chronos-2 (120M), G3_C5 Group Attention + C5

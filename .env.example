# === Pflicht =================================================================
# ENTSO-E Transparency Platform Security-Token (kostenlos):
#   https://transparency.entsoe.eu/  ->  Account Settings  ->  Web Api Security Token
ENTSOE_API_KEY=

# === Energy-Arena-Abgabe (optional) ==========================================
# Ohne diese laeuft alles als Dry-Run (Forecast wird berechnet, aber nicht gesendet).
ARENA_API_KEY=
SUBMIT_ENABLED=false          # auf true setzen fuer echte Abgabe (braucht ARENA_API_KEY)
ARENA_BASE=https://api.energy-arena.org
SUBMIT_FORMATS=point quantile ensemble

# === Modell / Laufzeit (Defaults sind sinnvoll) ==============================
DEVICE=cuda                   # cuda (NVIDIA/AMD-ROCm) oder cpu
PROD_CONFIG=G1_C5             # Submission-Champion; Fallback: G1_C1 (univariat)
# SMARD und Open-Meteo brauchen KEINEN Key.
